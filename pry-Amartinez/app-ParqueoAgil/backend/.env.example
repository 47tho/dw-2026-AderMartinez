PORT=3003
NODE_ENV=development
DB_DIALECT=mysql
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=123456
DB_MYSQL_NAME=ParqueoAgil

# ─────────────────────────────────────────────────────────────
# Fase II — Seguridad (JWT + RBAC)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=<SECRET_MIN_32_CHARS>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=7

# ─────────────────────────────────────────────────────────────
# Integración app móvil + panel web
# ─────────────────────────────────────────────────────────────
# Orígenes permitidos (CORS), separados por coma. 4200 = panel web
# (Angular); 8765 = app Flutter corriendo en el navegador.
CORS_ORIGINS=http://localhost:4200,http://localhost:8765

# Cobro: fracciones de N minutos (cada fracción que empieza se cobra
# completa), total aproximado al múltiplo de TARIFF_ROUND_TO más cercano.
# TARIFF_MINUTES_PER_FRACTION=60 vuelve al cobro por hora.
TARIFF_MINUTES_PER_FRACTION=15
TARIFF_ROUND_TO=100
TARIFF_GRACE_MINUTES=0

# Tickets de ejemplo en una base nueva (vehículos dentro y salidas del día)
SEED_DEMO_ACTIVITY=true
